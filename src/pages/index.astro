---
import '../styles/global.css';
import { profile, projects, experience } from '../data/profile';
const base = import.meta.env.BASE_URL;
const hasContact = profile.email || profile.github || profile.linkedin;
const siteConfigured = Astro.site?.hostname !== 'example.com';
const canonical = siteConfigured ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.name}'s portfolio: senior Python development, healthcare integrations, e-commerce systems, and data pipelines.`} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={`${profile.name} — Senior Python Developer`} />
    <meta property="og:description" content="Thoughtful integrations. Reliable background systems. Explore my selected engineering work." />
    <meta property="og:type" content="website" />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{profile.name} — Senior Python Developer & Integration Engineer</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a href="#home" class="wordmark" aria-label={`${profile.name}, home`}><span class="logo">m<span>.</span></span><span>{profile.name}<small>Senior Python developer</small></span></a>
      <nav aria-label="Main navigation"><a href="#work">Selected work</a><a href="#experience">Experience</a><a href="#about">About</a><a class="nav-contact" href="#contact">Let’s connect <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="main">
      <section id="home" class="hero wrap">
        <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> {profile.role}</p><p class="hero-name">Hi, I’m {profile.name}.</p><h1>Connecting systems.<br/>Solving <em>real problems.</em></h1><p class="intro">I build APIs, healthcare integrations, and data pipelines that turn complex workflows into practical software. My experience spans healthcare, e-commerce, and financial automation since 2018.</p><div class="hero-actions"><a class="button" href="#work">Explore my work <span aria-hidden="true">↗</span></a><a class="text-link linkedin-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer"><span class="linkedin-icon" aria-hidden="true">in</span> Connect on LinkedIn <span aria-hidden="true">↗</span></a></div><div class="hero-note"><span class="note-line"></span> From API discovery to production issue resolution.</div></div>
        <div class="hero-visual"><div class="identity-card"><img class="profile-photo" src={`${base}mikhil-kuppattil.png`} alt="Mikhil Kuppattil" width="104" height="104" fetchpriority="high" decoding="async" /><div><strong>{profile.name}</strong><span>Senior Python developer & integration engineer</span></div><a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="View Mikhil K on LinkedIn">in ↗</a></div><div class="system-art" role="img" aria-label="Conceptual architecture: healthcare APIs connect through an integration layer to background workers and application data.">
          <div class="art-heading"><span>THE WAY I THINK</span><span class="live-label">SYSTEM VIEW</span></div>
          <div class="art-source"><span class="node-icon">↗</span><div>Healthcare APIs<small>Different systems. Shared purpose.</small></div><span class="tiny-dot"></span></div>
          <div class="connector"><span>Connect & understand</span></div>
          <div class="art-core"><div class="core-symbol">{`{ }`}</div><div><small>THE INTEGRATION LAYER</small><strong>Make complexity<br/>work together.</strong></div></div>
          <div class="branch"><span></span><span></span></div>
          <div class="art-outputs"><div><span class="node-icon">↻</span><strong>Background jobs</strong><small>Celery + Celery Beat</small></div><div><span class="node-icon">▤</span><strong>Application data</strong><small>Connected workflows</small></div></div>
          <div class="art-footer"><span>01 / CONNECT</span><span>02 / PROCESS</span><span>03 / DELIVER</span></div>
        </div></div>
      </section>
      <div class="expertise-strip"><div class="wrap"><span>BUILT AROUND</span><p>Python</p><i>✳</i><p>API integrations</p><i>✳</i><p>Asynchronous systems</p><i>✳</i><p>Healthcare workflows</p></div></div>
      <section id="work" class="work-section wrap section-space">
        <div class="section-heading"><div><p class="eyebrow">SELECTED WORK / 01</p><h2>Real challenges.<br/><em>Thoughtful solutions.</em></h2></div><p>A selection of my work across clinical data, prescribing, eligibility, and insurance workflows.</p></div>
        <div class="projects">
          {projects.map((project) => <article class:list={['project', { featured: project.diagram }]} id={project.id}>
            <div class="project-top"><span class="project-number">/{project.number}</span><span class="project-category">{project.category}</span><span class="project-arrow" aria-hidden="true">↗</span></div>
            <h3>{project.title}</h3><p class="project-summary">{project.summary}</p>
            <ul class="tags" aria-label="Technologies and areas">{project.tags.map(tag => <li>{tag}</li>)}</ul>
            <details><summary>Read the case study <span aria-hidden="true">+</span></summary><div class="case-study"><h4>The challenge</h4><p>{project.challenge}</p><h4>My approach</h4><p>{project.approach}</p><h4>The result</h4><p>{project.outcome}</p>{project.diagram && <div class="flow" aria-label="Simplified synchronization flow"><span>Metriport API</span><b aria-hidden="true">↓</b><span>Celery background tasks</span><b aria-hidden="true">↓</b><span>Application data sync</span><small>Celery Beat schedules recurring jobs</small></div>}</div></details>
          </article>)}
        </div>
        <p class="work-footnote">Project descriptions focus on my contributions. Company source code and patient data are not shared.</p>
      </section>
      <section id="experience" class="experience-section wrap section-space" aria-labelledby="experience-title">
        <div class="section-heading"><div><p class="eyebrow">CAREER JOURNEY</p><h2 id="experience-title">Experience that connects<br/><em>industries and systems.</em></h2></div><p>From financial automation to e-commerce platforms and healthcare software.</p></div>
        <div class="experience-list">{experience.map(job => <article class="experience-item"><div class="experience-meta"><p>{job.dates}</p><span>{job.location}</span></div><div><h3>{job.role}</h3><p class="experience-company">{job.company}</p><p class="experience-summary">{job.summary}</p><ul class="tags" aria-label="Areas of work">{job.tags.map(tag => <li>{tag}</li>)}</ul></div></article>)}</div>
      </section>
      <section id="about" class="about-section"><div class="wrap about-grid section-space"><div><p class="eyebrow">THE PERSON BEHIND THE CODE / 02</p><h2>Curious by nature.<br/><em>Practical by design.</em></h2><p class="about-lead">I enjoy finding out how systems work—and making them work better together.</p><p>My work spans healthcare at Equipo Health, e-commerce at Ramz Al Oula, and financial automation at Actionfi Technologies. I’ve led a team of three and worked across backend development, data processing, and system integrations. I take ownership of clarifying requirements with testers, management, and third-party teams, then following the work through implementation and issue resolution.</p><p>I’ve also contributed to Access Program architecture discussions. I’m continuing to deepen my knowledge of system design, data engineering, and machine learning, and explore how AI tools can support end-to-end workflow automation.</p></div><div class="toolbox"><h3>My engineering toolkit <span aria-hidden="true">↙</span></h3><dl><div><dt>BUILD</dt><dd>Python · JavaScript · SQL · Django · Flask · FastAPI</dd></div><div><dt>ORCHESTRATE</dt><dd>Celery · RabbitMQ · Redis · Celery Beat</dd></div><div><dt>CONNECT</dt><dd>REST · GraphQL · WebSockets · Metriport · DoseSpot · Optum</dd></div><div><dt>DATA</dt><dd>PostgreSQL · MySQL · MongoDB · Pandas · NumPy</dd></div><div><dt>DELIVER</dt><dd>AWS · Docker · Linux · GitHub Actions · CI/CD</dd></div></dl><div class="education-note"><h3>Education</h3><p><strong>Master of Computer Applications</strong><br/>College of Engineering Vadakara · 2016–2019</p><p><strong>Bachelor of Computer Applications</strong><br/>Safi Institute of Advanced Study, University of Calicut · 2013–2016</p></div></div></div></section>
      <section id="contact" class="contact-section wrap section-space"><p class="eyebrow">START A CONVERSATION / 03</p><h2>Good systems start<br/>with a <em>good conversation.</em></h2><p>Interested in healthcare integrations, Python development, or asynchronous systems? Let’s talk.</p>{hasContact ? <div class="contact-links">{profile.email && <a class="button" href={`mailto:${profile.email}`}>Email me <span aria-hidden="true">↗</span></a>}{profile.github && <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}{profile.linkedin && <a class="button" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Let’s connect on LinkedIn <span aria-hidden="true">↗</span></a>}</div> : <p class="contact-pending">Public contact details will be added soon.</p>}</section>
    </main>
    <footer class="wrap"><a class="wordmark footer-mark" href="#home">{profile.name}<span> / Python developer</span></a><p>© {new Date().getFullYear()} {profile.name}</p><a href="#home">Back to top ↑</a></footer>
  </body>
</html>
